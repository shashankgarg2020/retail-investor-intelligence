=1;" edge="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c48" parent="1" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c49" parent="1" value="SQL + vectors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c50" parent="1" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c18" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c51" parent="1" value="ambiguous posts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c10" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c52" parent="1" value="stance + aspects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c53" parent="1" value="answer from evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1"