ue="Relevance rules (v2)&lt;br&gt;strong name? ambiguous name?&lt;br&gt;context? disambiguator?" style="rhombus;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="980" y="260" width="260" height="150" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="&lt;b&gt;Relevant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;score + reason stored&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1320" y="290" width="200" height="80" as="geometry" /></mxCell><mxCell id="c16" parent="1" value="&lt;b&gt;Irrelevant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;kept, excluded, reason shown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="1320" y="420" width="200" height="80" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="&lt;b&gt;LLM relevance check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Claude Haiku, batches of 10&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;label + 15-word reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="700" y="290" width="220" height="80" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="clear match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="e.g. Le&amp;#x27;Veon, Fortnite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="ambiguous" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" parent="1" value="relevant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="c17" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" parent="1" value="Enrichment (only posts that can count)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="540" width="1480" height="250" as="geometry" /></mxCell><mxCell id="c23" parent="1" value="&lt;b&gt;FinBERT baseline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;local finance model&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;label + score kept as&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;finbert_sentiment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="590" width="260" height="110" as="geometry" /></mxCell><mxCell id="c24" parent="1" value="&lt;b&gt;LLM investor stance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;&amp;#x27;good or bad for a shareholder?&amp;#x27;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;post type: opinion / news / data / question&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;aspects with a stance each + reason&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="360" y="590" width="340" height="110" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="&lt;b&gt;Topic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;keyword hits decide&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;embedding similarity breaks ties&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;else &amp;#x27;Other&amp;#x27;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="730" y="590" width="260" height="110" as="geometry" /></mxCell><mxCell id="c26" parent="1" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;bge-small, 384 dims&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;for semantic search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1020" y="590" width="220" height="110" as="geometry" /></mxCell><mxCell id="c27" parent="1" value="&lt;b&gt;Fallback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;no LLM key or failed batch:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;FinBERT label is used&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;(where PyTorch is installed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1270" y="590" width="220" height="110" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" source="c15" target="c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c23" target="c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c30" parent="1" value="&lt;b&gt;Stored&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;post_analysis · aspect_sentiment · embeddings&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;with model name, version and timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="240" y="860" width="600" height="90" as="geometry" /></mxCell><mxCell id="c31" parent="1" value="&lt;b&gt;analysis_posts view: the one definition of &amp;#x27;counts&amp;#x27;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;relevant AND English AND quality ok AND not duplicate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="900" y="860" width="560" height="90" as="geometry" /></mxCell><mxCell id="c32" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c23" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c33" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c24" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c34" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c25" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c35" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" parent="1" value="&lt;b&gt;Measured on 54 labelled posts:&lt;/b&gt; FinBERT 61% accuracy (put half the positive and negative posts in 'neutral'); LLM investor stance 87%. Relevance F1 0.80 to 0.94 after rules-v2. Labels were AI-drafted; see Method and reliability." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="990" width="1480" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="3. Assistant (RAG) flow" id="page-10926596"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" parent="1" value="How a question becomes a cited answer" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="18" width="1574" height="36" as="geometry" /></mxCell><mxCell id="c3" parent="1" value="Numbers come from SQL; the model only explains them and summarises retrieved posts, which it must cite." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontColor=#666666;" vertex="1"><mxGeometry x="40" y="60" width="1574" height="30" as="geometry" /></mxCell><mxCell id="c4" parent="1" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;&amp;#x27;What are investors&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;worried about?&amp;#x27;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="40" y="140" width="220" height="80" as="geometry" /></mxCell><mxCell id="c5" parent="1" value="&lt;b&gt;Planner (deterministic)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;intent: COUNT, TREND, TOPIC,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;EXPLANATION, COMPARISON ...&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;company, dates, platform,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;sentiment, keywords&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="300" y="120" width="300" height="120" as="geometry" /></mxCell><mxCell id="c6" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c7" parent="1" value="&lt;b&gt;SQL metrics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;overview, platforms, topics,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;emerging concerns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="660" y="110" width="300" height="90" as="geometry" /></mxCell><mxCell id="c8" parent="1" value="&lt;b&gt;Keyword search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Postgres full-text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="660" y="240" width="220" height="80" as="geometry" /></mxCell><mxCell id="c9" parent="1" value="&lt;b&gt;Vector search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;pgvector cosine (HNSW)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="660" y="350" width="220" height="80" as="geometry" /></mxCell><mxCell id="c10" parent="1" value="&lt;b&gt;Reciprocal Rank Fusion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;score = sum 1 / (60 + rank)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="930" y="290" width="220" height="90" as="geometry" /></mxCell><mxCell id="c11" parent="1" value="numbers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c12" parent="1" value="keywords + filters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c13" parent="1" value="embedding + filters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" parent="1" value="At least 2&lt;br&gt;relevant posts?" style="rhombus;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1190" y="270" width="220" height="130" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="&lt;b&gt;Abstain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;no LLM call;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;says why&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1450" y="290" width="170" height="90" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;question + scope + SQL metrics +&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;up to 14 posts wrapped as untrusted data&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;rules: no outside facts, no advice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1060" y="480" width="360" height="110" as="geometry" /></mxCell><mxCell id="c21" parent="1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" parent="1" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="c7" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" parent="1" value="&lt;b&gt;Claude Haiku (effort: low)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;structured output validated by Pydantic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="620" y="490" width="340" height="90" as="geometry" /></mxCell><mxCell id="c24" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="&lt;b&gt;Validate citations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;drop ids that were not retrieved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;drop themes with no source&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;no source at all -&amp;gt; marked unsupported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="220" y="480" width="340" height="110" as="geometry" /></mxCell><mxCell id="c26" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" parent="1" value="&lt;b&gt;Answer shown to the user&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;summary, themes with stance,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;source posts with links,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;scope, limitations, timing, cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="220" y="650" width="340" height="110" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" parent="1" value="&lt;b&gt;Measured&lt;/b&gt;&lt;br&gt;• Retrieval + SQL: ~0.3 s. Model writing: ~4.5 to 9 s (Haiku, low effort; was 13 s on Opus).&lt;br&gt;• Retrieval on 16 test questions, precision@5: vector 0.53, hybrid 0.50, keyword 0.36. Hybrid kept for exact names and tickers; weighting to be tuned on a larger set.&lt;br&gt;• About $0.001 per answer." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="660" y="650" width="900" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="4. Deployment" id="page-76600738"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" parent="1" value="Deployment: GitHub to Streamlit Community Cloud" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="18" width="1574" height="36" as="geometry" /></mxCell><mxCell id="c3" parent="1" value="One process on free hosting: the dashboard starts the API on a background thread. No PyTorch in the deployed app." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontColor=#666666;" vertex="1"><mxGeometry x="40" y="60" width="1574" height="30" as="geometry" /></mxCell><mxCell id="c4" parent="1" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;push to main&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="40" y="160" width="200" height="80" as="geometry" /></mxCell><mxCell id="c5" parent="1" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;code, docs, tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="290" y="160" width="220" height="80" as="geometry" /></mxCell><mxCell id="c6" parent="1" value="&lt;b&gt;Streamlit Community Cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;redeploys on every push&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;installs requirements.txt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="560" y="160" width="260" height="80" as="geometry" /></mxCell><mxCell id="c7" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" parent="1" value="Streamlit Cloud app  (free tier, Python 3.12)  ·  streamlit run src/frontend/app.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="300" width="960" height="420" as="geometry" /></mxCell><mxCell id="c10" parent="1" value="&lt;b&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;public HTTPS URL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;viewer toolbar (no Deploy button),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;no error details&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="80" y="360" width="260" height="110" as="geometry" /></mxCell><mxCell id="c11" parent="1" value="&lt;b&gt;FastAPI on a background thread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;127.0.0.1:8000, internal only&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;started once by ensure_backend()&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;warms the embedding model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="400" y="360" width="260" height="110" as="geometry" /></mxCell><mxCell id="c12" parent="1" value="&lt;b&gt;Refresh subprocess&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;python -m scripts.scheduler --once&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;collect -&amp;gt; analyse -&amp;gt; exit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;one at a time, 15 min cooldown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="720" y="360" width="250" height="110" as="geometry" /></mxCell><mxCell id="c13" parent="1" value="&lt;b&gt;Lightweight models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;bge-small on ONNX Runtime (fastembed)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;sentiment by Claude&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;(FinBERT only in the Docker build)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="400" y="540" width="260" height="110" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="&lt;b&gt;App secrets (TOML)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;DATABASE_URL, ANTHROPIC_API_KEY,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;YOUTUBE_API_KEY, BLUESKY_*&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;copied to env at start-up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="80" y="540" width="260" height="110" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="build + run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" parent="1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="POST /refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="&lt;b&gt;Viewers (IR team)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="80" y="790" width="260" height="80" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="https://&amp;lt;app&amp;gt;.streamlit.app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c19" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" parent="1" value="&lt;b&gt;Neon PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;managed, serverless&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1100" y="330" width="300" height="80" as="geometry" /></mxCell><mxCell id="c22" parent="1" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Claude Haiku&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="1100" y="450" width="300" height="80" as="geometry" /></mxCell><mxCell id="c23" parent="1" value="&lt;b&gt;YouTube + Bluesky APIs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;(Reddit once approved)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1100" y="570" width="300" height="80" as="geometry" /></mxCell><mxCell id="c24" parent="1" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" parent="1" value="labels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c12" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c27" parent="1" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="collect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c12" target="c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c29" parent="1" value="&lt;b&gt;Why this setup&lt;/b&gt;&lt;br&gt;Vercel runs short serverless functions; this app needs a long-running Streamlit server. Docker on Hugging Face Spaces now needs a paid plan. Streamlit Community Cloud is free and deploys from GitHub, but runs one process with limited memory, so the deployed app drops PyTorch: embeddings use ONNX Runtime (identical vectors) and Claude labels sentiment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Trade-off:&lt;/b&gt; a free app sleeps when idle and wakes in about a minute.&lt;br&gt;&lt;br&gt;&lt;b&gt;Full version:&lt;/b&gt; the Dockerfile adds FinBERT and runs on any container host (Railway, Render, Fly.io). &lt;b&gt;Local:&lt;/b&gt; docker compose (Postgres + API + UI + optional scheduler)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1100" y="700" width="520" height="260" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="5. Design choices, trade-offs and roadmap" id="page-85058565"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1754" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" parent="1" value="Design choices, trade-offs and where it goes next" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="18" width="1674" height="36" as="geometry" /></mxCell><mxCell id="c3" parent="1" value="Keep the MVP simple and measurable; each choice names the signal that would make us change it." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontColor=#666666;" vertex="1"><mxGeometry x="40" y="60" width="1674" height="30" as="geometry" /></mxCell><mxCell id="c4" parent="1" value="&amp;lt;table style=&amp;quot;border-collapse:collapse;font-size:11px;width:100%&amp;quot;&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;th style=&amp;quot;text-align:left;padding:5px 8px;background:#eef3fb;width:150px&amp;quot;&amp;gt;Decision&amp;lt;/th&amp;gt;&amp;lt;th style=&amp;quot;text-align:left;padding:5px 8px;background:#eef3fb;width:190px&amp;quot;&amp;gt;MVP choice&amp;lt;/th&amp;gt;&amp;lt;th style=&amp;quot;text-align:left;padding:5px 8px;background:#eef3fb;width:230px&amp;quot;&amp;gt;Why&amp;lt;/th&amp;gt;&amp;lt;th style=&amp;quot;text-align:left;padding:5px 8px;background:#eef3fb;width:300px&amp;quot;&amp;gt;Reconsider when&amp;lt;/th&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Monolith vs services&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Modular monolith&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Fast to build, one deploy&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Teams or parts need to scale separately&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Batch vs streaming&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Scheduled batch + Refresh&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Hours-old data is enough for IR&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Near-real-time alerts are required&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Database&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;PostgreSQL&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Joins, filters, aggregates, full-text&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Document workloads dominate&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Vector store&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;pgvector in the same DB&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;One store, no sync&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Vector load or features justify Qdrant/Pinecone&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Sentiment&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;LLM stance, FinBERT baseline&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;87% vs 61% on labelled posts&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Cost/latency at scale -&amp;amp;gt; fine-tune a small model on LLM labels&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Fine-tuning vs prompting&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Prompting&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;No large labelled set yet&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;A measured gap on human labels&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Retrieval&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Hybrid (full-text + vector, RRF)&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Exact tickers + meaning&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Larger eval shows weighting or a reranker wins&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Agent vs planner&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Deterministic planner&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Predictable, auditable&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Complex multi-tool questions prove useful&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Numbers&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;SQL only&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Deterministic, checkable&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Never: the LLM only explains&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Assistant model&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Haiku, low effort&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;13 s -&amp;amp;gt; ~5 s, 25x cheaper than Opus&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Answer quality drops on harder questions&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Briefing&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Fixed rules, no LLM&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Same data, same words; instant&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Users need narrative beyond rules&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Frameworks&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;No LangChain&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Each RAG step visible and testable&amp;lt;/td&amp;gt;&amp;lt;td style=&amp;quot;padding:5px 8px;border-top:1px solid #ddd;vertical-align:top&amp;quot;&amp;gt;Orchestration needs grow (state, tools)&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;/table&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=11;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="40" y="110" width="1000" height="640" as="geometry" /></mxCell><mxCell id="c5" parent="1" value="&lt;b&gt;Scaling to 100,000 posts a day&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=15;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1080" y="110" width="640" height="30" as="geometry" /></mxCell><mxCell id="c6" parent="1" value="&lt;b&gt;Ingestion workers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;per platform&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1080" y="150" width="180" height="60" as="geometry" /></mxCell><mxCell id="c7" parent="1" value="&lt;b&gt;Message queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Redis / RabbitMQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1300" y="150" width="180" height="60" as="geometry" /></mxCell><mxCell id="c8" parent="1" value="&lt;b&gt;Airflow / Prefect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-