<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram name="1. System architecture" id="page-29914933"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" parent="1" value="Retail Investor Intelligence: system architecture" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=24;fontStyle=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="18" width="1574" height="36" as="geometry" /></mxCell><mxCell id="c3" parent="1" value="Public posts in, evidence-backed answers out. Batch work runs in separate processes; the API only reads." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=13;fontStyle=0;align=left;verticalAlign=top;fontColor=#666666;" vertex="1"><mxGeometry x="40" y="60" width="1574" height="30" as="geometry" /></mxCell><mxCell id="c4" parent="1" value="Data sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="110" width="1160" height="120" as="geometry" /></mxCell><mxCell id="c5" parent="1" value="&lt;b&gt;YouTube Data API v3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;videos + comments (real)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="150" width="340" height="64" as="geometry" /></mxCell><mxCell id="c6" parent="1" value="&lt;b&gt;Bluesky (AT Protocol)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;post search, app password (real)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="440" y="150" width="340" height="64" as="geometry" /></mxCell><mxCell id="c7" parent="1" value="&lt;b&gt;Reddit Data API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;adapter built; awaiting approval (synthetic data)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="810" y="150" width="360" height="64" as="geometry" /></mxCell><mxCell id="c8" parent="1" value="Batch pipeline  (scheduler every 6 h, or the dashboard&amp;#x27;s Refresh button)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="260" width="1160" height="330" as="geometry" /></mxCell><mxCell id="c9" parent="1" value="&lt;b&gt;Ingestion adapters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;one interface per platform&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;pagination, retries + backoff, rate limits&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;checkpoints with overlap, partial success&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;every run logged (ingestion_runs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="300" width="330" height="120" as="geometry" /></mxCell><mxCell id="c10" parent="1" value="&lt;b&gt;Processing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;normalise to one schema&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;dedupe: platform id + text hash&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;language, spam/quality flags&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;relevance: rules-v2, then LLM for ambiguous&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="440" y="300" width="330" height="120" as="geometry" /></mxCell><mxCell id="c11" parent="1" value="&lt;b&gt;Intelligence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;LLM investor stance, post type, aspects&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;FinBERT baseline (Docker build)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;topics: keywords + embeddings&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;embeddings: bge-small (384-d)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="810" y="300" width="360" height="120" as="geometry" /></mxCell><mxCell id="c12" parent="1" value="&lt;b&gt;Scheduler / Refresh&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;APScheduler (6 h) or POST /refresh&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;runs `scheduler --once` as a subprocess&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;one run at a time, cooldown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="460" width="330" height="100" as="geometry" /></mxCell><mxCell id="c13" parent="1" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;labelled posts + test questions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;precision / recall / F1, MRR, latency&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;results.json shown in the UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="440" y="460" width="330" height="100" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="&lt;b&gt;PostgreSQL + pgvector (Neon)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;posts, post_analysis, aspect_sentiment&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;embeddings (HNSW), ingestion_runs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;view analysis_posts = what counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="810" y="460" width="360" height="100" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="FastAPI  (reads only; never loads FinBERT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="620" width="1160" height="200" as="geometry" /></mxCell><mxCell id="c16" parent="1" value="&lt;b&gt;Analytics API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;SQL aggregates: overview, topics,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;aspects, trends, freshness&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;executive briefing (fixed rules)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="660" width="340" height="130" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="&lt;b&gt;RAG assistant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;planner -&amp;gt; SQL metrics&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;hybrid retrieval (full-text + vector, RRF)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Claude -&amp;gt; citation check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="440" y="660" width="340" height="130" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="&lt;b&gt;Refresh + quality API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;POST /refresh, GET /refresh/status&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;GET /quality (evaluation scores)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;rate limit on chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="810" y="660" width="360" height="130" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="Streamlit dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;arcSize=3;fontFamily=Helvetica;fontSize=13;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1"><mxGeometry x="40" y="850" width="1160" height="130" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="&lt;b&gt;Executive briefing  ·  Sentiment and platforms  ·  Topics and aspects  ·  Post explorer  ·  Ask the data  ·  Method and reliability&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="70" y="890" width="1100" height="64" as="geometry" /></mxCell><mxCell id="c21" parent="1" value="&lt;b&gt;Anthropic Claude Haiku&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;relevance check, investor stance,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;aspects, assistant answers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;structured output (Pydantic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="1260" y="330" width="330" height="110" as="geometry" /></mxCell><mxCell id="c22" parent="1" value="Legend" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1260" y="620" width="200" height="20" as="geometry" /></mxCell><mxCell id="c23" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="644" width="18" height="18" as="geometry" /></mxCell><mxCell id="c24" parent="1" value="Data sources" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="642" width="180" height="20" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="670" width="18" height="18" as="geometry" /></mxCell><mxCell id="c26" parent="1" value="Ingestion" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="668" width="180" height="20" as="geometry" /></mxCell><mxCell id="c27" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="696" width="18" height="18" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="Processing" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="694" width="180" height="20" as="geometry" /></mxCell><mxCell id="c29" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="722" width="18" height="18" as="geometry" /></mxCell><mxCell id="c30" parent="1" value="Machine learning / LLM" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="720" width="180" height="20" as="geometry" /></mxCell><mxCell id="c31" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="748" width="18" height="18" as="geometry" /></mxCell><mxCell id="c32" parent="1" value="Storage" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="746" width="180" height="20" as="geometry" /></mxCell><mxCell id="c33" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="774" width="18" height="18" as="geometry" /></mxCell><mxCell id="c34" parent="1" value="API / services" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="772" width="180" height="20" as="geometry" /></mxCell><mxCell id="c35" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="800" width="18" height="18" as="geometry" /></mxCell><mxCell id="c36" parent="1" value="User interface" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="798" width="180" height="20" as="geometry" /></mxCell><mxCell id="c37" parent="1" value="&lt;b&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1260" y="826" width="18" height="18" as="geometry" /></mxCell><mxCell id="c38" parent="1" value="External service" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1286" y="824" width="180" height="20" as="geometry" /></mxCell><mxCell id="c39" parent="1" value="&lt;b&gt;Key ideas&lt;/b&gt;&lt;br&gt;• Numbers come from SQL, never from the LLM.&lt;br&gt;• Every post links to its source.&lt;br&gt;• Model output is stored with model name and reason.&lt;br&gt;• A failing platform never stops the others." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1260" y="860" width="360" height="120" as="geometry" /></mxCell><mxCell id="c40" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;st