t;Dedicated vector DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;only if measured load needs it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;dashed=1;" vertex="1"><mxGeometry x="1410" y="370" width="300" height="60" as="geometry" /></mxCell><mxCell id="c14" parent="1" value="&lt;b&gt;React / Next.js front end&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;auth + roles per company&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1080" y="470" width="300" height="60" as="geometry" /></mxCell><mxCell id="c15" parent="1" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;logs, metrics, traces, cost, freshness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;fontSize=13;align=center;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1410" y="470" width="300" height="60" as="geometry" /></mxCell><mxCell id="c16" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" parent="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontFamily=Helvetica;fontSize=13;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" parent="1" value="&lt;b&gt;Roadmap&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=15;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="1080" y="570" width="640" height="30" as="geometry" /></mxCell><mxCell id="c25" parent="1" value="&lt;b&gt;Now&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Human-labelled hold-out set&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Streaming answers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Retention job for deleted posts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Reddit once approved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontSize=13;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1080" y="610" width="200" height="200" as="geometry" /></mxCell><mxCell id="c26" parent="1" value="&lt;b&gt;Next&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Alerts on growing concerns&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Reranker / weighted fusion&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Compare with official disclosures&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;More languages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=13;fontSize=13;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1300" y="610" width="200" height="200" as="geometry" /></mxCell><mxCell id="c27" parent="1" value="&lt;b&gt;Later&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Investor Concern Score once&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;weights are validated&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Fine-tuned stance model&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#444444&quot;&gt;Multi-tenant SaaS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=13;fontSize=13;align=left;verticalAlign=middle;spacing=8;arcSize=8;" vertex="1"><mxGeometry x="1520" y="610" width="200" height="200" as="geometry" /></mxCell><mxCell id="c28" parent="1" value="&lt;b&gt;Security and governance&lt;/b&gt;&lt;br&gt;Secrets in environment / Space secrets, never in Git · parameterised SQL · input validation (Pydantic) · rate limit on chat, cooldown + optional token on refresh · posts treated as untrusted text in every prompt · synthetic data always labelled · not investment advice.&lt;br&gt;&lt;br&gt;&lt;b&gt;Risks&lt;/b&gt;: platform access and licensing, noisy data, entity mix-ups, model errors on sarcasm, unrepresentative posters, hallucination (mitigated by citations + abstention), stale data (freshness shown)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#333333;" vertex="1"><mxGeometry x="40" y="780" width="1000" height="160" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>