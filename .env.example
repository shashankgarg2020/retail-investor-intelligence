# Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
# Neon connection string, e.g. postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- LLM: investor-stance sentiment, aspects, ambiguous relevance checks and the assistant.
#     Without it the pipeline falls back to FinBERT and the assistant to an extractive answer. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_FAST_MODEL=claude-haiku-5-5

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Bluesky (handle like yourname.bsky.social + an app password, not your login password) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Reddit (script app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent, e.g. windows:retail-investor-intelligence:v0.1 (by /u/yourname)
REDDIT_USER_AGENT=

# --- App ---
API_BASE_URL=http://127.0.0.1:8000

# --- Refresh button ---
# Optional shared secret for refreshes started outside the dashboard, and minutes between runs.
REFRESH_TOKEN=
REFRESH_COOLDOWN_MIN=15
